<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>$(NetpulseGUINet)-windows10.0.17763.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <AssemblyName>NetpulseGUI</AssemblyName>
    <RootNamespace>NetpulseGUI</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\netpulse.ico</ApplicationIcon>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
    <InvariantGlobalization>false</InvariantGlobalization>
    <NoWarn>$(NoWarn);NU1701</NoWarn>
  </PropertyGroup>

  <!-- Портативная сборка: один exe -->
  <PropertyGroup Condition="'$(PublishSingleFile)' == 'true'">
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>embedded</DebugType>
  </PropertyGroup>
  <!-- Сжатие доступно только для self-contained (со встроенным .NET) -->
  <PropertyGroup Condition="'$(PublishSingleFile)' == 'true' and '$(SelfContained)' == 'true'">
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>
  <!-- Lite-сборка без встроенного .NET: помечаем, чтобы автообновление скачивало тоже lite -->
  <ItemGroup Condition="'$(PublishSingleFile)' == 'true' and '$(SelfContained)' != 'true'">
    <AssemblyMetadata Include="NetpulseGUI.Flavor" Value="lite" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="WPF-UI" />
    <PackageReference Include="LiveChartsCore.SkiaSharpView.WPF" />
    <PackageReference Include="H.NotifyIcon.Wpf" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" />
    <PackageReference Include="TaskScheduler" />
    <PackageReference Include="ClosedXML" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>

  <!-- msdia140.dll из TraceEvent нужен только для разбора символов (TraceLog); мы читаем события
       в реальном времени, поэтому не тащим ~9 МБ библиотек на три архитектуры. -->
  <Target Name="DropMsdia" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Filename)' == 'msdia140'" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\NetpulseGUI.Core\NetpulseGUI.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\netpulse.ico" />
  </ItemGroup>
</Project>
