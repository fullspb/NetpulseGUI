<ui:FluentWindow x:Class="NetpulseGUI.Views.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:l="clr-namespace:NetpulseGUI.Localization"
                 xmlns:pages="clr-namespace:NetpulseGUI.Views.Pages"
                 Title="NetpulseGUI"
                 Width="1180" Height="780" MinWidth="920" MinHeight="600"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 WindowStartupLocation="CenterScreen"
                 Icon="pack://application:,,,/Assets/netpulse.ico">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="NetpulseGUI">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/netpulse.ico" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <StackPanel Grid.Row="1" Margin="16,0,16,0">
            <Grid Visibility="{Binding ShowAdminBanner, Converter={StaticResource BoolToVis}}" Margin="0,0,0,8">
                <ui:InfoBar Title="{l:Loc Admin_BannerTitle}" Message="{l:Loc Admin_BannerMessage}"
                            Severity="Warning" IsClosable="True" IsOpen="{Binding ShowAdminBanner, Mode=TwoWay}" Padding="12,8,300,8" />
                <ui:Button Content="{l:Loc Admin_Restart}" Appearance="Primary" Icon="{ui:SymbolIcon Shield24}"
                           Command="{Binding RestartElevatedCommand}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,52,0" />
            </Grid>
            <Grid Visibility="{Binding IsPaused, Converter={StaticResource BoolToVis}}" Margin="0,0,0,8">
                <ui:InfoBar Title="{l:Loc Paused_Title}" Message="{l:Loc Paused_Message}" Severity="Informational"
                            IsClosable="False" IsOpen="True" Padding="12,8,200,8" />
                <ui:Button Content="{l:Loc Paused_Resume}" Icon="{ui:SymbolIcon Play24}" Command="{Binding ResumeCommand}"
                           HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0" />
            </Grid>
            <ui:InfoBar Title="{Binding InfoTitle}" Message="{Binding InfoMessage}" Severity="{Binding InfoSeverity}"
                        IsClosable="True" IsOpen="{Binding InfoOpen, Mode=TwoWay}" Margin="0,0,0,8" />
        </StackPanel>

        <ui:NavigationView x:Name="RootNavigation" Grid.Row="2"
                           PaneDisplayMode="Left"
                           OpenPaneLength="230"
                           IsBackButtonVisible="Collapsed"
                           IsPaneToggleVisible="True"
                           FrameMargin="0">
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem x:Name="NavDashboard" Content="{l:Loc Nav_Dashboard}" Icon="{ui:SymbolIcon Gauge24}"
                                       TargetPageType="{x:Type pages:DashboardPage}" />
                <ui:NavigationViewItem Content="{l:Loc Nav_Processes}" Icon="{ui:SymbolIcon Apps24}"
                                       TargetPageType="{x:Type pages:ProcessesPage}" />
                <ui:NavigationViewItem Content="{l:Loc Nav_Reports}" Icon="{ui:SymbolIcon DataBarVertical24}"
                                       TargetPageType="{x:Type pages:ReportsPage}" />
                <ui:NavigationViewItem Content="{l:Loc Nav_Limits}" Icon="{ui:SymbolIcon Alert24}"
                                       TargetPageType="{x:Type pages:LimitsPage}" />
            </ui:NavigationView.MenuItems>
            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem Content="{l:Loc Nav_Settings}" Icon="{ui:SymbolIcon Settings24}"
                                       TargetPageType="{x:Type pages:SettingsPage}">
                    <ui:NavigationViewItem.InfoBadge>
                        <ui:InfoBadge Severity="Attention" Style="{DynamicResource DotInfoBadgeStyle}"
                                      Visibility="{Binding UpdateAvailable, Converter={StaticResource BoolToVis}}" />
                    </ui:NavigationViewItem.InfoBadge>
                </ui:NavigationViewItem>
            </ui:NavigationView.FooterMenuItems>
        </ui:NavigationView>
    </Grid>
</ui:FluentWindow>
