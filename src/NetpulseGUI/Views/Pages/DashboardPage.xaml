<Page x:Class="NetpulseGUI.Views.Pages.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
      xmlns:l="clr-namespace:NetpulseGUI.Localization"
      Title="Dashboard">
    <StackPanel Margin="24,8,24,24">
        <TextBlock Text="{l:Loc Nav_Dashboard}" Style="{StaticResource PageTitle}" />

        <!-- Текущая скорость -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ui:Card Grid.Column="0" Padding="20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="52" Height="52" CornerRadius="26" Background="{DynamicResource AccentFillColorDefaultBrush}" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="ArrowDown24" FontSize="26" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{l:Loc Common_Download}" Style="{StaticResource Caption}" />
                        <TextBlock Text="{Binding DownSpeed}" Style="{StaticResource BigValue}" />
                        <TextBlock Style="{StaticResource Caption}">
                            <Run Text="{l:Loc Dashboard_Peak}" /><Run Text=": " /><Run Text="{Binding PeakDown, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </ui:Card>
            <ui:Card Grid.Column="2" Padding="20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="52" Height="52" CornerRadius="26" Background="#FFFF9A3C" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="ArrowUp24" FontSize="26" Foreground="White" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{l:Loc Common_Upload}" Style="{StaticResource Caption}" />
                        <TextBlock Text="{Binding UpSpeed}" Style="{StaticResource BigValue}" />
                        <TextBlock Style="{StaticResource Caption}">
                            <Run Text="{l:Loc Dashboard_Peak}" /><Run Text=": " /><Run Text="{Binding PeakUp, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </ui:Card>
        </Grid>

        <!-- Живой график -->
        <ui:Card Margin="0,16,0,0" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="260" />
                </Grid.RowDefinitions>
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <RadioButton Style="{StaticResource Segment}" GroupName="DashRange" Content="{l:Loc Range_60s}" IsChecked="{Binding Range60}" />
                        <RadioButton Style="{StaticResource Segment}" GroupName="DashRange" Content="{l:Loc Range_5m}" IsChecked="{Binding Range300}" />
                        <RadioButton Style="{StaticResource Segment}" GroupName="DashRange" Content="{l:Loc Range_1h}" IsChecked="{Binding Range3600}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{l:Loc Dashboard_LiveChart}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <Ellipse Width="10" Height="10" Fill="{DynamicResource AccentFillColorDefaultBrush}" Margin="16,0,4,0" VerticalAlignment="Center" />
                        <TextBlock Text="{l:Loc Common_Download}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                        <Ellipse Width="10" Height="10" Fill="#FFFF9A3C" Margin="12,0,4,0" VerticalAlignment="Center" />
                        <TextBlock Text="{l:Loc Common_Upload}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                    </StackPanel>
                </DockPanel>
                <lvc:CartesianChart Background="Transparent" Grid.Row="1" Margin="0,8,0,0"
                                    Series="{Binding Series}" XAxes="{Binding XAxes}" YAxes="{Binding YAxes}"
                                    TooltipPosition="Top" LegendPosition="Hidden"
                                    AnimationsSpeed="00:00:00.450" ZoomMode="None" />
            </Grid>
        </ui:Card>

        <!-- Итоги -->
        <UniformGrid Columns="3" Margin="-8,16,-8,0">
            <ui:Card Margin="8,0" Padding="18" VerticalAlignment="Stretch">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="CalendarToday24" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                        <TextBlock Text="{l:Loc Common_Today}" Style="{StaticResource Caption}" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding TodayTotal}" Style="{StaticResource MidValue}" Margin="0,8,0,2" />
                    <TextBlock Text="{Binding TodayDetails}" Style="{StaticResource Caption}" />
                </StackPanel>
            </ui:Card>
            <ui:Card Margin="8,0" Padding="18" VerticalAlignment="Stretch">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="CalendarMonth24" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                        <TextBlock Text="{l:Loc Common_Month}" Style="{StaticResource Caption}" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding MonthTotal}" Style="{StaticResource MidValue}" Margin="0,8,0,2" />
                    <TextBlock Text="{Binding MonthDetails}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                </StackPanel>
            </ui:Card>
            <ui:Card Margin="8,0" Padding="18" VerticalAlignment="Stretch">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Database24" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                        <TextBlock Text="{l:Loc Common_AllTime}" Style="{StaticResource Caption}" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding AllTotal}" Style="{StaticResource MidValue}" Margin="0,8,0,2" />
                    <TextBlock Text="{Binding AllDetails}" Style="{StaticResource Caption}" />
                </StackPanel>
            </ui:Card>
        </UniformGrid>

        <!-- Топ-5 процессов -->
        <ui:Card Margin="0,16,0,0" Padding="16">
            <StackPanel>
                <DockPanel>
                    <ui:Button DockPanel.Dock="Right" Content="{l:Loc Dashboard_AllProcesses}" Appearance="Transparent"
                               Icon="{ui:SymbolIcon ChevronRight24}" Command="{Binding OpenProcessesCommand}" />
                    <TextBlock Text="{l:Loc Dashboard_TopNow}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                </DockPanel>

                <StackPanel Visibility="{Binding ProcessTrackingAvailable, Converter={StaticResource InvBoolToVis}}" Margin="0,8,0,0">
                    <TextBlock Text="{l:Loc Dashboard_NoProcessTracking}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                    <ui:Button Content="{l:Loc Admin_Restart}" Icon="{ui:SymbolIcon Shield24}" Margin="0,8,0,0" Command="{Binding RestartElevatedCommand}" />
                </StackPanel>

                <TextBlock Text="{l:Loc Dashboard_NoActivity}" Style="{StaticResource Caption}" Margin="0,12,0,4">
                    <TextBlock.Visibility>
                        <MultiBinding Converter="{x:Static l:VisibilityHelpers.BothTrue}">
                            <Binding Path="ProcessTrackingAvailable" />
                            <Binding Path="HasTopProcesses" Converter="{StaticResource InvBool}" />
                        </MultiBinding>
                    </TextBlock.Visibility>
                </TextBlock>

                <ItemsControl ItemsSource="{Binding TopProcesses}" Margin="0,8,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Background="Transparent" BorderThickness="0" Padding="4,6" HorizontalContentAlignment="Stretch" Cursor="Hand"
                                    Command="{Binding DataContext.OpenProcessCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}" ToolTip="{Binding ToolTip}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32" />
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="3*" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>
                                    <Image Source="{Binding Icon}" Width="20" Height="20" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <ProgressBar Grid.Column="2" Value="{Binding Share, Mode=OneWay}" Maximum="1" Height="4" Margin="12,0" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="3" VerticalAlignment="Center" TextAlignment="Right" Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                                        <Run Text="↓" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" /> <Run Text="{Binding DownSpeedText, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock Grid.Column="4" VerticalAlignment="Center" TextAlignment="Right" Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                                        <Run Text="↑" Foreground="#FFFF9A3C" /> <Run Text="{Binding UpSpeedText, Mode=OneWay}" />
                                    </TextBlock>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ui:Card>
    </StackPanel>
</Page>
