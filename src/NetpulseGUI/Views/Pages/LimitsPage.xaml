<Page x:Class="NetpulseGUI.Views.Pages.LimitsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:l="clr-namespace:NetpulseGUI.Localization"
      Title="Limits">
    <StackPanel Margin="24,8,24,24">
        <TextBlock Text="{l:Loc Nav_Limits}" Style="{StaticResource PageTitle}" />

        <!-- Использование -->
        <UniformGrid Columns="2" Margin="-8,0,-8,0">
            <ui:Card Margin="8,0" Padding="18" VerticalAlignment="Stretch">
                <StackPanel>
                    <TextBlock Text="{l:Loc Limit_Daily}" Style="{StaticResource Caption}" />
                    <TextBlock Text="{Binding TodayUsed}" Style="{StaticResource MidValue}" Margin="0,6,0,8" />
                    <ProgressBar Value="{Binding TodayPercent, Mode=OneWay}" Maximum="100" Height="6" />
                    <TextBlock Text="{Binding TodayLeft}" Style="{StaticResource Caption}" Margin="0,8,0,0" />
                </StackPanel>
            </ui:Card>
            <ui:Card Margin="8,0" Padding="18" VerticalAlignment="Stretch">
                <StackPanel>
                    <TextBlock Text="{l:Loc Limit_Monthly}" Style="{StaticResource Caption}" />
                    <TextBlock Text="{Binding MonthUsed}" Style="{StaticResource MidValue}" Margin="0,6,0,8" />
                    <ProgressBar Value="{Binding MonthPercent, Mode=OneWay}" Maximum="100" Height="6" />
                    <TextBlock Text="{Binding MonthLeft}" Style="{StaticResource Caption}" Margin="0,8,0,0" />
                    <TextBlock Text="{Binding PeriodText}" Style="{StaticResource Caption}" />
                    <TextBlock Text="{Binding ForecastText}" Margin="0,4,0,0" FontWeight="SemiBold">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ForecastExceeds}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </ui:Card>
        </UniformGrid>

        <TextBlock Text="{l:Loc Limits_Settings}" Style="{StaticResource SectionTitle}" />

        <ui:CardControl Icon="{ui:SymbolIcon CalendarToday24}" Margin="0,0,0,4">
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Text="{l:Loc Limit_Daily}" FontWeight="SemiBold" />
                    <TextBlock Text="{l:Loc Limits_DailyHint}" Style="{StaticResource Caption}" />
                </StackPanel>
            </ui:CardControl.Header>
            <StackPanel Orientation="Horizontal">
                <ui:NumberBox Value="{Binding DailyGb, UpdateSourceTrigger=PropertyChanged}" Minimum="0.1" Maximum="100000" SmallChange="1" LargeChange="10"
                              MaxDecimalPlaces="1" Width="140" IsEnabled="{Binding DailyEnabled}" />
                <TextBlock Text="{l:Loc Limits_Gb}" VerticalAlignment="Center" Margin="8,0,16,0" />
                <ui:ToggleSwitch IsChecked="{Binding DailyEnabled}" />
            </StackPanel>
        </ui:CardControl>

        <ui:CardControl Icon="{ui:SymbolIcon CalendarMonth24}" Margin="0,0,0,4">
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Text="{l:Loc Limit_Monthly}" FontWeight="SemiBold" />
                    <TextBlock Text="{l:Loc Limits_MonthlyHint}" Style="{StaticResource Caption}" />
                </StackPanel>
            </ui:CardControl.Header>
            <StackPanel Orientation="Horizontal">
                <ui:NumberBox Value="{Binding MonthlyGb, UpdateSourceTrigger=PropertyChanged}" Minimum="0.1" Maximum="1000000" SmallChange="10" LargeChange="100"
                              MaxDecimalPlaces="1" Width="140" IsEnabled="{Binding MonthlyEnabled}" />
                <TextBlock Text="{l:Loc Limits_Gb}" VerticalAlignment="Center" Margin="8,0,16,0" />
                <ui:ToggleSwitch IsChecked="{Binding MonthlyEnabled}" />
            </StackPanel>
        </ui:CardControl>

        <ui:CardControl Icon="{ui:SymbolIcon CalendarArrowRight24}" Margin="0,0,0,4">
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Text="{l:Loc Limits_StartDay}" FontWeight="SemiBold" />
                    <TextBlock Text="{l:Loc Limits_StartDayHint}" Style="{StaticResource Caption}" />
                </StackPanel>
            </ui:CardControl.Header>
            <ComboBox ItemsSource="{Binding Days}" SelectedItem="{Binding BillingStartDay}" Width="90" />
        </ui:CardControl>

        <ui:CardControl Icon="{ui:SymbolIcon ArrowSortUp24}" Margin="0,0,0,4">
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Text="{l:Loc Limits_CountUpload}" FontWeight="SemiBold" />
                    <TextBlock Text="{l:Loc Limits_CountUploadHint}" Style="{StaticResource Caption}" />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:ToggleSwitch IsChecked="{Binding CountUpload}" />
        </ui:CardControl>

        <ui:CardControl Icon="{ui:SymbolIcon AlertBadge24}" Margin="0,0,0,4">
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Text="{l:Loc Limits_Notify}" FontWeight="SemiBold" />
                    <TextBlock Text="{l:Loc Limits_NotifyHint}" Style="{StaticResource Caption}" />
                </StackPanel>
            </ui:CardControl.Header>
            <StackPanel Orientation="Horizontal">
                <CheckBox Content="80%" IsChecked="{Binding Notify80}" Margin="0,0,12,0" />
                <CheckBox Content="90%" IsChecked="{Binding Notify90}" Margin="0,0,12,0" />
                <CheckBox Content="100%" IsChecked="{Binding Notify100}" Margin="0,0,16,0" />
                <ui:Button Content="{l:Loc Limits_Test}" Icon="{ui:SymbolIcon Alert24}" Command="{Binding TestNotificationCommand}" />
            </StackPanel>
        </ui:CardControl>

        <TextBlock Text="{l:Loc Limits_History}" Style="{StaticResource SectionTitle}" />
        <ui:Card Padding="12">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding Alerts}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Time}" Style="{StaticResource Caption}" />
                                <TextBlock Grid.Column="1" Text="{Binding Message}" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{l:Loc Limits_NoAlerts}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Alerts.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </ui:Card>
    </StackPanel>
</Page>
