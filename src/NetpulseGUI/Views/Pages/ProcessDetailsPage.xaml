<Page x:Class="NetpulseGUI.Views.Pages.ProcessDetailsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
      xmlns:l="clr-namespace:NetpulseGUI.Localization"
      Title="Process">
    <StackPanel Margin="24,8,24,24">
        <ui:Button Content="{l:Loc Details_Back}" Icon="{ui:SymbolIcon ArrowLeft24}" Appearance="Transparent"
                   Command="{Binding BackCommand}" Margin="-8,0,0,8" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Width="56" Height="56" CornerRadius="12" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                <Image Source="{Binding Icon}" Width="36" Height="36" />
            </Border>
            <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding Name}" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Path}" Style="{StaticResource Caption}" />
            </StackPanel>
            <ui:Button Grid.Column="2" Content="{l:Loc Details_OpenFolder}" Icon="{ui:SymbolIcon FolderOpen24}"
                       Command="{Binding OpenFolderCommand}" Visibility="{Binding CanOpenFolder, Converter={StaticResource BoolToVis}}" />
        </Grid>

        <UniformGrid Columns="5" Margin="-6,20,-6,0">
            <ui:Card Margin="6,0" Padding="14" VerticalAlignment="Stretch">
                <StackPanel>
                    <TextBlock Text="{l:Loc Processes_DownNow}" Style="{StaticResource Caption}" />
                    <TextBlock Text="{Binding DownSpeed}" Style="{StaticResource MidValue}" Margin="0,6,0,0" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                </StackPanel>
            </ui:Card>
            <ui:Card Margin="6,0" Padding="14" VerticalAlignment="Stretch">
                <StackPanel>
                    <TextBlock Text="{l:Loc Processes_UpNow}" Style="{StaticResource Caption}" />
                    <TextBlock Text="{Binding UpSpeed}" Style="{StaticResource MidValue}" Margin="0,6,0,0" Foreground="#FFFF9A3C" />
                </StackPanel>
            </ui:Card>
            <ui:Card Margin="6,0" Padding="14" VerticalAlignment="Stretch">
                <StackPanel>
                    <TextBlock Text="{l:Loc Common_Today}" Style="{StaticResource Caption}" />
                    <TextBlock Text="{Binding Today}" Style="{StaticResource MidValue}" Margin="0,6,0,0" />
                </StackPanel>
            </ui:Card>
            <ui:Card Margin="6,0" Padding="14" VerticalAlignment="Stretch">
                <StackPanel>
                    <TextBlock Text="{l:Loc Common_Month}" Style="{StaticResource Caption}" />
                    <TextBlock Text="{Binding Month}" Style="{StaticResource MidValue}" Margin="0,6,0,0" />
                </StackPanel>
            </ui:Card>
            <ui:Card Margin="6,0" Padding="14" VerticalAlignment="Stretch">
                <StackPanel>
                    <TextBlock Text="{l:Loc Common_AllTime}" Style="{StaticResource Caption}" />
                    <TextBlock Text="{Binding AllTime}" Style="{StaticResource MidValue}" Margin="0,6,0,0" />
                </StackPanel>
            </ui:Card>
        </UniformGrid>

        <ui:Card Margin="0,16,0,0" Padding="16">
            <StackPanel>
                <TextBlock Text="{l:Loc Details_Live}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <lvc:CartesianChart Height="140" Margin="0,8,0,0" Series="{Binding LiveSeries}" XAxes="{Binding HiddenX}" YAxes="{Binding LiveYAxes}"
                                    TooltipPosition="Hidden" LegendPosition="Hidden" AnimationsSpeed="00:00:00.400" />
            </StackPanel>
        </ui:Card>

        <ui:Card Margin="0,16,0,0" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="300" />
                </Grid.RowDefinitions>
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <RadioButton Style="{StaticResource Segment}" GroupName="DetRange" Content="{l:Loc Range_1h}" IsChecked="{Binding RangeHour}" />
                        <RadioButton Style="{StaticResource Segment}" GroupName="DetRange" Content="{l:Loc Range_24h}" IsChecked="{Binding RangeDay}" />
                        <RadioButton Style="{StaticResource Segment}" GroupName="DetRange" Content="{l:Loc Range_7d}" IsChecked="{Binding RangeWeek}" />
                        <RadioButton Style="{StaticResource Segment}" GroupName="DetRange" Content="{l:Loc Range_30d}" IsChecked="{Binding RangeMonth}" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="{l:Loc Details_History}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="{Binding RangeTotal}" Style="{StaticResource Caption}" />
                    </StackPanel>
                </DockPanel>
                <lvc:CartesianChart Grid.Row="1" Margin="0,8,0,0" Series="{Binding Series}" XAxes="{Binding XAxes}" YAxes="{Binding YAxes}"
                                    TooltipPosition="Top" LegendPosition="Hidden" />
                <TextBlock Grid.Row="1" Text="{l:Loc Common_NoData}" Style="{StaticResource Caption}" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding HasData, Converter={StaticResource InvBoolToVis}}" />
            </Grid>
        </ui:Card>
    </StackPanel>
</Page>
