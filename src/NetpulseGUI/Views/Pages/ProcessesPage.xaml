<Page x:Class="NetpulseGUI.Views.Pages.ProcessesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:l="clr-namespace:NetpulseGUI.Localization"
      xmlns:c="clr-namespace:NetpulseGUI.Controls"
      Title="Processes"
      ScrollViewer.CanContentScroll="False">
    <Grid Margin="24,8,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Text="{l:Loc Nav_Processes}" Style="{StaticResource PageTitle}" />

        <ui:InfoBar Grid.Row="1" Title="{l:Loc Processes_NoTrackingTitle}" Message="{l:Loc Dashboard_NoProcessTracking}"
                    Severity="Warning" IsClosable="False" Margin="0,0,0,12"
                    IsOpen="{Binding ProcessTrackingAvailable, Converter={StaticResource InvBool}}" />

        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="420" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:TextBox PlaceholderText="{l:Loc Processes_Search}" Icon="{ui:SymbolIcon Search24}"
                        Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" ClearButtonEnabled="True" />
            <ComboBox Grid.Column="1" Margin="12,0,0,0" MinWidth="170"
                      ItemsSource="{Binding Periods}" SelectedItem="{Binding SelectedPeriod}" DisplayMemberPath="Label" />
            <TextBlock Grid.Column="2" Text="{Binding Summary}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="16,0" />
            <ui:Button Grid.Column="3" Icon="{ui:SymbolIcon ArrowSync24}" Content="{l:Loc Common_Refresh}" Command="{Binding LoadCommand}" />
        </Grid>

        <ui:Card Grid.Row="3" Padding="0" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch">
            <Grid>
                <DataGrid x:Name="Grid" ItemsSource="{Binding View}"
                          AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                          SelectionMode="Single" HeadersVisibility="Column" GridLinesVisibility="None"
                          RowHeight="40" EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling" BorderThickness="0"
                          MouseDoubleClick="OnRowDoubleClick" KeyDown="OnGridKeyDown">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="{l:Loc Common_Process}" Width="2*" MinWidth="200" SortMemberPath="Name" CanUserSort="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" ToolTip="{Binding ToolTip}">
                                        <Image Source="{Binding Icon}" Width="20" Height="20" Margin="0,0,10,0" />
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Instances, StringFormat=' ×{0}'}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="4,0,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="{l:Loc Processes_Activity}" Width="130" MinWidth="110" CanUserSort="True" SortMemberPath="TotalSpeed">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <c:Sparkline Values="{Binding Spark}" Height="22" Margin="4,0" Stroke="{DynamicResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="{l:Loc Processes_DownNow}" Width="*" MinWidth="100" Binding="{Binding DownSpeedText}" SortMemberPath="DownSpeed" />
                        <DataGridTextColumn Header="{l:Loc Processes_UpNow}" Width="*" MinWidth="100" Binding="{Binding UpSpeedText}" SortMemberPath="UpSpeed" />
                        <DataGridTextColumn Header="{l:Loc Processes_DownPeriod}" Width="*" MinWidth="100" Binding="{Binding PeriodDownText}" SortMemberPath="PeriodDown" />
                        <DataGridTextColumn Header="{l:Loc Processes_UpPeriod}" Width="*" MinWidth="100" Binding="{Binding PeriodUpText}" SortMemberPath="PeriodUp" />
                        <DataGridTextColumn Header="{l:Loc Processes_TotalPeriod}" Width="*" MinWidth="100" Binding="{Binding PeriodTotalText}" SortMemberPath="PeriodTotal" SortDirection="Descending" />
                    </DataGrid.Columns>
                </DataGrid>
                <ui:ProgressRing IsIndeterminate="True" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
        </ui:Card>
    </Grid>
</Page>
