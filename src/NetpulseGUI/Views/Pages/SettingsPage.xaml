<Page x:Class="NetpulseGUI.Views.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:l="clr-namespace:NetpulseGUI.Localization"
      Title="Settings">
    <StackPanel Margin="24,8,24,24">
        <TextBlock Text="{l:Loc Nav_Settings}" Style="{StaticResource PageTitle}" />

        <ui:InfoBar Title="{l:Loc Settings_RestartRequired}" Message="{l:Loc Settings_RestartRequiredDetails}" Severity="Informational"
                    IsClosable="False" IsOpen="{Binding RestartRequired}" Margin="0,0,0,8">
            <ui:InfoBar.Content>
                <ui:Button Content="{l:Loc Settings_RestartNow}" Command="{Binding RestartCommand}" Margin="0,4,0,0" />
            </ui:InfoBar.Content>
        </ui:InfoBar>

        <!-- Запуск -->
        <TextBlock Text="{l:Loc Settings_Startup}" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
        <ui:CardControl Icon="{ui:SymbolIcon Power24}" Margin="0,0,0,4">
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Text="{l:Loc Settings_AutoStart}" FontWeight="SemiBold" />
                    <TextBlock Text="{l:Loc Settings_AutoStartHint}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:ToggleSwitch IsChecked="{Binding AutoStart}" IsEnabled="{Binding IsElevated}" />
        </ui:CardControl>
        <ui:CardControl Icon="{ui:SymbolIcon ArrowMinimize24}" Margin="0,0,0,4">
            <ui:CardControl.Header>
                <TextBlock Text="{l:Loc Settings_MinimizeToTray}" FontWeight="SemiBold" />
            </ui:CardControl.Header>
            <ui:ToggleSwitch IsChecked="{Binding MinimizeToTray}" />
        </ui:CardControl>
        <ui:CardControl Icon="{ui:SymbolIcon EyeOff24}" Margin="0,0,0,4">
            <ui:CardControl.Header>
                <TextBlock Text="{l:Loc Settings_StartMinimized}" FontWeight="SemiBold" />
            </ui:CardControl.Header>
            <ui:ToggleSwitch IsChecked="{Binding StartMinimized}" />
        </ui:CardControl>
        <ui:CardControl Icon="{ui:SymbolIcon Shield24}" Margin="0,0,0,4">
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Text="{l:Loc Settings_ProcessTracking}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding EtwStatus}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                </StackPanel>
            </ui:CardControl.Header>
            <StackPanel Orientation="Horizontal">
                <ui:Button Content="{l:Loc Admin_Restart}" Icon="{ui:SymbolIcon Shield24}" Command="{Binding RestartElevatedCommand}" Margin="0,0,12,0"
                           Visibility="{Binding IsElevated, Converter={StaticResource InvBoolToVis}}" />
                <ui:ToggleSwitch IsChecked="{Binding ProcessTracking}" />
            </StackPanel>
        </ui:CardControl>

        <!-- Внешний вид -->
        <TextBlock Text="{l:Loc Settings_Appearance}" Style="{StaticResource SectionTitle}" />
        <ui:CardControl Icon="{ui:SymbolIcon DarkTheme24}" Margin="0,0,0,4">
            <ui:CardControl.Header>
                <TextBlock Text="{l:Loc Settings_Theme}" FontWeight="SemiBold" />
            </ui:CardControl.Header>
            <ComboBox SelectedIndex="{Binding ThemeIndex}" MinWidth="180">
                <ComboBoxItem Content="{l:Loc Settings_ThemeSystem}" />
                <ComboBoxItem Content="{l:Loc Settings_ThemeLight}" />
                <ComboBoxItem Content="{l:Loc Settings_ThemeDark}" />
            </ComboBox>
        </ui:CardControl>
        <ui:CardControl Icon="{ui:SymbolIcon LocalLanguage24}" Margin="0,0,0,4">
            <ui:CardControl.Header>
                <TextBlock Text="{l:Loc Settings_Language}" FontWeight="SemiBold" />
            </ui:CardControl.Header>
            <ComboBox SelectedIndex="{Binding LanguageIndex}" MinWidth="180">
                <ComboBoxItem Content="Русский" />
                <ComboBoxItem Content="English" />
            </ComboBox>
        </ui:CardControl>
        <ui:CardControl Icon="{ui:SymbolIcon TopSpeed24}" Margin="0,0,0,4">
            <ui:CardControl.Header>
                <TextBlock Text="{l:Loc Settings_Units}" FontWeight="SemiBold" />
            </ui:CardControl.Header>
            <ComboBox SelectedIndex="{Binding UnitsIndex}" MinWidth="180">
                <ComboBoxItem Content="{l:Loc Settings_UnitsBits}" />
                <ComboBoxItem Content="{l:Loc Settings_UnitsBytes}" />
            </ComboBox>
        </ui:CardControl>
        <ui:CardControl Icon="{ui:SymbolIcon Timer24}" Margin="0,0,0,4">
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Text="{l:Loc Settings_Refresh}" FontWeight="SemiBold" />
                    <TextBlock Text="{l:Loc Settings_RefreshHint}" Style="{StaticResource Caption}" />
                </StackPanel>
            </ui:CardControl.Header>
            <ComboBox SelectedIndex="{Binding RefreshIndex}" MinWidth="180">
                <ComboBoxItem Content="{l:Loc Settings_Refresh1}" />
                <ComboBoxItem Content="{l:Loc Settings_Refresh2}" />
                <ComboBoxItem Content="{l:Loc Settings_Refresh5}" />
            </ComboBox>
        </ui:CardControl>

        <!-- Адаптеры -->
        <TextBlock Text="{l:Loc Settings_Adapters}" Style="{StaticResource SectionTitle}" />
        <ui:CardControl Icon="{ui:SymbolIcon Server24}" Margin="0,0,0,4">
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Text="{l:Loc Settings_IncludeVirtual}" FontWeight="SemiBold" />
                    <TextBlock Text="{l:Loc Settings_IncludeVirtualHint}" Style="{StaticResource Caption}" />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:ToggleSwitch IsChecked="{Binding IncludeVirtual}" />
        </ui:CardControl>
        <ui:CardControl Icon="{ui:SymbolIcon LockClosed24}" Margin="0,0,0,4">
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Text="{l:Loc Settings_IncludeVpn}" FontWeight="SemiBold" />
                    <TextBlock Text="{l:Loc Settings_IncludeVpnHint}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:ToggleSwitch IsChecked="{Binding IncludeVpn}" />
        </ui:CardControl>
        <ui:CardExpander Icon="{ui:SymbolIcon NetworkCheck24}" Margin="0,0,0,4" IsExpanded="False">
            <ui:CardExpander.Header>
                <StackPanel>
                    <TextBlock Text="{l:Loc Settings_AdapterList}" FontWeight="SemiBold" />
                    <TextBlock Text="{l:Loc Settings_AdapterListHint}" Style="{StaticResource Caption}" />
                </StackPanel>
            </ui:CardExpander.Header>
            <ItemsControl ItemsSource="{Binding Adapters}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <CheckBox IsChecked="{Binding IsIncluded}" VerticalAlignment="Center" MinWidth="0" />
                            <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                <TextBlock Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                                    <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" /> <Run Text="{Binding Description, Mode=OneWay}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </TextBlock>
                                <TextBlock Text="{Binding Details}" Style="{StaticResource Caption}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ui:CardExpander>

        <!-- Данные -->
        <TextBlock Text="{l:Loc Settings_Data}" Style="{StaticResource SectionTitle}" />
        <ui:CardControl Icon="{ui:SymbolIcon Database24}" Margin="0,0,0,4">
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Text="{l:Loc Settings_Database}" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource Caption}"><Run Text="{Binding DatabasePath, Mode=OneWay}" />  ·  <Run Text="{Binding DatabaseSize, Mode=OneWay}" /></TextBlock>
                </StackPanel>
            </ui:CardControl.Header>
            <StackPanel Orientation="Horizontal">
                <ui:Button Content="{l:Loc Settings_OpenFolder}" Icon="{ui:SymbolIcon FolderOpen24}" Command="{Binding OpenDataFolderCommand}" Margin="0,0,8,0" />
                <ui:Button Content="{l:Loc Settings_Logs}" Icon="{ui:SymbolIcon DocumentText24}" Command="{Binding OpenLogsCommand}" />
            </StackPanel>
        </ui:CardControl>
        <ui:CardControl Icon="{ui:SymbolIcon Save24}" Margin="0,0,0,4">
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Text="{l:Loc Settings_Backup}" FontWeight="SemiBold" />
                    <TextBlock Text="{l:Loc Settings_BackupHint}" Style="{StaticResource Caption}" />
                </StackPanel>
            </ui:CardControl.Header>
            <StackPanel Orientation="Horizontal">
                <ui:Button Content="{l:Loc Settings_BackupCreate}" Icon="{ui:SymbolIcon Save24}" Command="{Binding BackupCommand}" Margin="0,0,8,0" />
                <ui:Button Content="{l:Loc Settings_Restore}" Icon="{ui:SymbolIcon ArrowUpload24}" Command="{Binding RestoreCommand}" />
            </StackPanel>
        </ui:CardControl>
        <ui:CardControl Icon="{ui:SymbolIcon Delete24}" Margin="0,0,0,4">
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Text="{l:Loc Settings_Reset}" FontWeight="SemiBold" />
                    <TextBlock Text="{l:Loc Settings_ResetHint}" Style="{StaticResource Caption}" />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:Button Content="{l:Loc Settings_ResetButton}" Icon="{ui:SymbolIcon Delete24}" Command="{Binding ResetStatsCommand}" />
        </ui:CardControl>

        <!-- О программе -->
        <TextBlock Text="{l:Loc Settings_About}" Style="{StaticResource SectionTitle}" />
        <ui:Card Padding="16">
            <StackPanel Orientation="Horizontal">
                <Image Source="pack://application:,,,/Assets/netpulse.ico" Width="40" Height="40" />
                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"><Run Text="NetpulseGUI " /><Run Text="{Binding Version, Mode=OneWay}" /></TextBlock>
                    <TextBlock Text="{l:Loc Settings_AboutText}" Style="{StaticResource Caption}" />
                </StackPanel>
            </StackPanel>
        </ui:Card>
    </StackPanel>
</Page>
