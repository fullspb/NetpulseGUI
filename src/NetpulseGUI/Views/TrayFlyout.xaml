<ui:FluentWindow x:Class="NetpulseGUI.Views.TrayFlyout"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
                 xmlns:l="clr-namespace:NetpulseGUI.Localization"
                 Title="NetpulseGUI"
                 Width="340" SizeToContent="Height"
                 WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Acrylic"
                 WindowCornerPreference="Round"
                 ShowActivated="True">
    <Border Padding="16" BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
        <StackPanel>
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <ui:Button Appearance="Transparent" Padding="6" Command="{Binding OpenReportCommand}" ToolTip="{l:Loc Tray_TodayReport}"
                               Icon="{ui:SymbolIcon DataBarVertical20}" />
                    <ui:Button Appearance="Transparent" Padding="6" Command="{Binding TogglePauseCommand}" ToolTip="{l:Loc Tray_Pause}">
                        <ui:Button.Style>
                            <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                <Setter Property="Icon" Value="{ui:SymbolIcon Pause20}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                        <Setter Property="Icon" Value="{ui:SymbolIcon Play20}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:Button.Style>
                    </ui:Button>
                    <ui:Button Appearance="Transparent" Padding="6" Command="{Binding OpenCommand}" ToolTip="{l:Loc Tray_Open}"
                               Icon="{ui:SymbolIcon Open20}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/Assets/netpulse.ico" Width="18" Height="18" />
                    <TextBlock Text="NetpulseGUI" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock Text="{l:Loc Common_Paused}" Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource Caption}"
                               Visibility="{Binding IsPaused, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </DockPanel>

            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource Caption}"><Run Text="↓" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" /> <Run Text="{l:Loc Common_Download}" /></TextBlock>
                    <TextBlock Text="{Binding DownSpeed}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Style="{StaticResource Caption}"><Run Text="↑" Foreground="#FFFF9A3C" /> <Run Text="{l:Loc Common_Upload}" /></TextBlock>
                    <TextBlock Text="{Binding UpSpeed}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                </StackPanel>
            </Grid>

            <lvc:CartesianChart Height="80" Margin="-4,8,-4,0" Series="{Binding Series}" XAxes="{Binding XAxes}" YAxes="{Binding YAxes}"
                                TooltipPosition="Hidden" LegendPosition="Hidden" AnimationsSpeed="00:00:00.300" />

            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{l:Loc Common_Today}" Style="{StaticResource Caption}" />
                    <TextBlock Text="{Binding Today}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{l:Loc Common_Month}" Style="{StaticResource Caption}" />
                    <TextBlock Text="{Binding Month}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                </StackPanel>
            </Grid>

            <Separator Margin="0,12,0,8" />
            <TextBlock Text="{l:Loc Flyout_Top}" Style="{StaticResource Caption}" Margin="0,0,0,4" />
            <TextBlock Text="{l:Loc Flyout_NoTracking}" Style="{StaticResource Caption}" TextWrapping="Wrap"
                       Visibility="{Binding ProcessTrackingAvailable, Converter={StaticResource InvBoolToVis}}" />
            <ItemsControl ItemsSource="{Binding Top}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Image Source="{Binding Icon}" Width="16" Height="16" />
                            <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock Grid.Column="2" VerticalAlignment="Center" Style="{StaticResource Caption}" Margin="8,0,0,0">
                                <Run Text="↓" /> <Run Text="{Binding DownSpeedText, Mode=OneWay}" />  <Run Text="↑" /> <Run Text="{Binding UpSpeedText, Mode=OneWay}" />
                            </TextBlock>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
</ui:FluentWindow>
