import { Palette } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { AppState } from "state.slint";
import { NavItem, Glyph, Caption } from "widgets.slint";
import { DashboardPage, ProcessesPage, DetailsPage, ReportsPage, LimitsPage, SettingsPage } from "pages.slint";

export { AppState, Theme }
export { ProcRow, Bar, Slice, AdapterRow, AlertRow } from "widgets.slint";

export component AppWindow inherits Window {
    title: "NetpulseRS";
    icon: @image-url("../assets/icon.png");
    preferred-width: 1100px;
    preferred-height: 740px;
    min-width: 860px;
    min-height: 560px;
    background: Theme.window-bg;
    default-font-size: 13px;

    property <bool> dark: Theme.dark;
    init => { Palette.color-scheme = root.dark ? ColorScheme.dark : ColorScheme.light; }
    changed dark => { Palette.color-scheme = root.dark ? ColorScheme.dark : ColorScheme.light; }

    HorizontalLayout {
        Rectangle {
            width: 220px;
            background: Theme.sidebar-bg;
            VerticalLayout {
                padding: 8px;
                padding-top: 14px;
                spacing: 2px;
                HorizontalLayout {
                    padding-left: 12px;
                    padding-bottom: 14px;
                    spacing: 10px;
                    Image { source: @image-url("../assets/icon.png"); width: 22px; height: 22px; }
                    Text { text: "NetpulseRS"; color: Theme.text; font-size: 15px; font-weight: 600; vertical-alignment: center; }
                }
                NavItem { icon: "\u{E80F}"; text: @tr("Главная"); selected: AppState.page == 0; clicked => { AppState.navigate(0); } }
                NavItem { icon: "\u{E8FD}"; text: @tr("Процессы"); selected: AppState.page == 1 || AppState.page == 5; clicked => { AppState.navigate(1); } }
                NavItem { icon: "\u{E9D2}"; text: @tr("Отчёты"); selected: AppState.page == 2; clicked => { AppState.navigate(2); } }
                NavItem { icon: "\u{E916}"; text: @tr("Лимиты"); selected: AppState.page == 3; clicked => { AppState.navigate(3); } }
                Rectangle { vertical-stretch: 1; }
                HorizontalLayout {
                    padding-left: 14px;
                    padding-bottom: 6px;
                    spacing: 8px;
                    VerticalLayout {
                        alignment: center;
                        Rectangle { width: 8px; height: 8px; border-radius: 4px; background: AppState.paused ? Theme.text3 : AppState.etw-active ? Theme.success : Theme.up; }
                    }
                    Caption {
                        text: AppState.paused ? @tr("Пауза") : AppState.etw-active ? @tr("Сбор данных идёт") : @tr("Только адаптеры");
                        font-size: 11px;
                    }
                }
                NavItem { icon: "\u{E713}"; text: @tr("Настройки"); selected: AppState.page == 4; clicked => { AppState.navigate(4); } }
            }
        }
        Rectangle {
            horizontal-stretch: 1;
            if AppState.page == 0: DashboardPage { }
            if AppState.page == 1: ProcessesPage { }
            if AppState.page == 2: ReportsPage { }
            if AppState.page == 3: LimitsPage { }
            if AppState.page == 4: SettingsPage { }
            if AppState.page == 5: DetailsPage { }
        }
    }
}
