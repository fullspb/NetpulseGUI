import { Theme } from "theme.slint";

export struct ProcRow {
    key: string,
    name: string,
    path: string,
    icon: image,
    c1: string,
    c2: string,
    c3: string,
    pct: string,
    share: float,
}

export struct Bar {
    down: float,
    up: float,
    label: string,
    tip: string,
}

export struct Slice {
    path: string,
    color: color,
    name: string,
    value: string,
    pct: string,
}

export struct AdapterRow {
    id: string,
    name: string,
    desc: string,
    details: string,
    enabled: bool,
    up: bool,
}

export struct AlertRow {
    time: string,
    text: string,
}

export component Card inherits Rectangle {
    background: Theme.card;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: Theme.border;
}

export component Caption inherits Text {
    color: Theme.text2;
    font-size: 12px;
}

export component SectionTitle inherits Text {
    color: Theme.text;
    font-size: 15px;
    font-weight: 600;
}

export component PageTitle inherits Text {
    color: Theme.text;
    font-size: 26px;
    font-weight: 600;
}

export component Glyph inherits Text {
    font-family: Theme.icon-font;
    font-size: 16px;
    color: Theme.text;
    vertical-alignment: center;
    horizontal-alignment: center;
}

// Пункт бокового меню.
export component NavItem inherits Rectangle {
    in property <string> icon;
    in property <string> text;
    in property <bool> selected;
    in property <bool> badge;
    callback clicked;
    height: 38px;
    border-radius: 5px;
    background: selected ? Theme.nav-selected : ta.has-hover ? Theme.nav-hover : transparent;
    Rectangle {
        x: 0;
        width: 3px;
        height: selected ? 16px : 0px;
        border-radius: 1.5px;
        background: Theme.accent;
        animate height { duration: 120ms; }
    }
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 10px;
        spacing: 14px;
        Glyph { text: root.icon; width: 18px; }
        Text {
            text: root.text;
            color: Theme.text;
            font-size: 14px;
            vertical-alignment: center;
            overflow: elide;
        }
    }
    ta := TouchArea { clicked => { root.clicked(); } }
}

// Плоская кнопка с текстом и (необязательно) значком.
export component FlatButton inherits Rectangle {
    in property <string> icon;
    in property <string> text;
    in property <bool> primary;
    in property <bool> enabled: true;
    callback clicked;
    height: 32px;
    min-width: hl.preferred-width;
    border-radius: 5px;
    border-width: primary ? 0px : 1px;
    border-color: Theme.border;
    background: primary ? (ta.has-hover ? Theme.accent.darker(0.1) : Theme.accent) : (ta.has-hover ? Theme.card-hover : Theme.card);
    opacity: enabled ? 1 : 0.5;
    hl := HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 8px;
        alignment: center;
        if root.icon != "": Glyph {
            text: root.icon;
            font-size: 13px;
            color: root.primary ? Theme.accent-text : Theme.text;
        }
        if root.text != "": Text {
            text: root.text;
            color: root.primary ? Theme.accent-text : Theme.text;
            font-size: 13px;
            vertical-alignment: center;
        }
    }
    ta := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

// Переключатель вариантов (как SegmentedControl).
export component Segmented inherits Rectangle {
    in property <[string]> items;
    in-out property <int> current;
    callback changed(int);
    height: 32px;
    border-radius: 5px;
    border-width: 1px;
    border-color: Theme.border;
    background: Theme.card;
    min-width: hl.preferred-width;
    hl := HorizontalLayout {
        padding: 3px;
        spacing: 2px;
        for it[i] in root.items: Rectangle {
            border-radius: 4px;
            min-width: t.preferred-width + 24px;
            background: i == root.current ? Theme.accent : sta.has-hover ? Theme.card-hover : transparent;
            t := Text {
                text: it;
                font-size: 13px;
                color: i == root.current ? Theme.accent-text : Theme.text;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            sta := TouchArea {
                clicked => {
                    root.current = i;
                    root.changed(i);
                }
            }
        }
    }
}

// Строка настроек: заголовок, подсказка и элемент управления справа.
export component SettingRow inherits Card {
    in property <string> title;
    in property <string> hint;
    in property <string> icon;
    min-height: 64px;
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 10px;
        padding-bottom: 10px;
        spacing: 16px;
        if root.icon != "": Glyph { text: root.icon; width: 20px; color: Theme.text2; }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;
            Text { text: root.title; color: Theme.text; font-size: 14px; wrap: word-wrap; }
            if root.hint != "": Caption { text: root.hint; wrap: word-wrap; }
        }
        HorizontalLayout {
            alignment: end;
            spacing: 8px;
            @children
        }
    }
}

// Карточка с крупным значением.
export component StatCard inherits Card {
    in property <string> title;
    in property <string> value;
    in property <string> details;
    in property <string> icon;
    in property <color> accent: Theme.text;
    min-width: 150px;
    horizontal-stretch: 1;
    VerticalLayout {
        padding: 16px;
        spacing: 4px;
        HorizontalLayout {
            spacing: 6px;
            if root.icon != "": Glyph { text: root.icon; font-size: 12px; color: root.accent; width: 14px; }
            Caption { text: root.title; overflow: elide; }
        }
        Text {
            text: root.value;
            color: root.accent;
            font-size: 22px;
            font-weight: 600;
            overflow: elide;
        }
        Caption { text: root.details; overflow: elide; }
    }
}

// Заголовок колонки таблицы с сортировкой.
component HeaderCell inherits Rectangle {
    in property <string> text;
    in property <int> idx;
    in property <int> sort-col;
    in property <bool> sort-asc;
    in property <bool> right;
    callback sort(int);
    height: 30px;
    HorizontalLayout {
        alignment: root.right ? end : start;
        spacing: 4px;
        Text {
            text: root.text;
            color: Theme.text2;
            font-size: 12px;
            font-weight: 600;
            vertical-alignment: center;
        }
        Glyph {
            text: root.idx == root.sort-col ? (root.sort-asc ? "\u{E70E}" : "\u{E70D}") : "";
            font-size: 9px;
            color: Theme.text2;
            width: 10px;
        }
    }
    TouchArea { clicked => { root.sort(root.idx); } }
}

// Таблица процессов: имя (с иконкой) и три числовые колонки, выровненные по правому краю, плюс доля.
export component ProcTable inherits VerticalLayout {
    in property <[ProcRow]> rows;
    in property <string> h1;
    in property <string> h2;
    in property <string> h3;
    in property <bool> show-pct;
    in property <int> sort-col;
    in property <bool> sort-asc;
    in property <length> num-width: 120px;
    callback sort(int);
    callback open(ProcRow);
    spacing: 0px;
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 8px;
        HeaderCell { text: @tr("Процесс"); idx: 0; sort-col: root.sort-col; sort-asc: root.sort-asc; sort(c) => { root.sort(c); } horizontal-stretch: 1; }
        HeaderCell { text: root.h1; idx: 1; right: true; width: root.num-width; sort-col: root.sort-col; sort-asc: root.sort-asc; sort(c) => { root.sort(c); } }
        HeaderCell { text: root.h2; idx: 2; right: true; width: root.num-width; sort-col: root.sort-col; sort-asc: root.sort-asc; sort(c) => { root.sort(c); } }
        HeaderCell { text: root.h3; idx: 3; right: true; width: root.num-width; sort-col: root.sort-col; sort-asc: root.sort-asc; sort(c) => { root.sort(c); } }
        if root.show-pct: HeaderCell { text: "%"; idx: 3; right: true; width: 64px; sort-col: -1; sort(c) => { root.sort(c); } }
    }
    Rectangle { height: 1px; background: Theme.border; }
    for r in root.rows: Rectangle {
        height: 36px;
        border-radius: 4px;
        background: rta.has-hover ? Theme.card-hover : transparent;
        HorizontalLayout {
            padding-left: 12px;
            padding-right: 12px;
            spacing: 8px;
            HorizontalLayout {
                horizontal-stretch: 1;
                spacing: 10px;
                VerticalLayout {
                    alignment: center;
                    width: 20px;
                    Image {
                        source: r.icon;
                        width: 20px;
                        height: 20px;
                        image-fit: contain;
                    }
                }
                VerticalLayout {
                    alignment: center;
                    spacing: 3px;
                    Text {
                        text: r.name;
                        color: Theme.text;
                        font-size: 13px;
                        overflow: elide;
                    }
                    if root.show-pct: Rectangle {
                        height: 3px;
                        border-radius: 1.5px;
                        background: Theme.track;
                        Rectangle {
                            x: 0;
                            width: parent.width * clamp(r.share, 0, 1);
                            border-radius: 1.5px;
                            background: Theme.accent;
                        }
                    }
                }
            }
            Text { text: r.c1; width: root.num-width; color: Theme.text; font-size: 13px; horizontal-alignment: right; vertical-alignment: center; }
            Text { text: r.c2; width: root.num-width; color: Theme.text; font-size: 13px; horizontal-alignment: right; vertical-alignment: center; }
            Text { text: r.c3; width: root.num-width; color: Theme.text; font-size: 13px; font-weight: 600; horizontal-alignment: right; vertical-alignment: center; }
            if root.show-pct: Text { text: r.pct; width: 64px; color: Theme.text2; font-size: 13px; horizontal-alignment: right; vertical-alignment: center; }
        }
        rta := TouchArea {
            mouse-cursor: pointer;
            double-clicked => { root.open(r); }
        }
    }
}

// Линейный график скорости (две области). Пути строятся в Rust в системе координат 1000×1000.
export component LineChart inherits Rectangle {
    in property <string> down-line;
    in property <string> down-area;
    in property <string> up-line;
    in property <string> up-area;
    in property <[string]> y-labels;
    in property <string> x-left;
    in property <string> x-right;
    in property <int> points;
    pure callback tip(int) -> string;
    property <length> left-pad: 76px;
    min-height: 220px;
    // сетка и подписи оси Y (сверху вниз)
    for l[i] in root.y-labels: Rectangle {
        x: root.left-pad;
        y: (root.height - 22px) * i / max(1, root.y-labels.length - 1);
        width: root.width - root.left-pad;
        height: 1px;
        background: Theme.grid;
        Text {
            x: -root.left-pad;
            y: -7px;
            width: root.left-pad - 8px;
            text: l;
            font-size: 11px;
            color: Theme.text3;
            horizontal-alignment: right;
        }
    }
    area := Rectangle {
        x: root.left-pad;
        y: 0;
        width: root.width - root.left-pad;
        height: root.height - 22px;
        clip: true;
        Path {
            width: 100%;
            height: 100%;
            viewbox-width: 1000;
            viewbox-height: 1000;
            fit: fill;
            commands: root.down-area;
            fill: Theme.down.with-alpha(0.16);
        }
        Path {
            width: 100%;
            height: 100%;
            viewbox-width: 1000;
            viewbox-height: 1000;
            fit: fill;
            commands: root.down-line;
            stroke: Theme.down;
            stroke-width: 1.5px;
        }
        Path {
            width: 100%;
            height: 100%;
            viewbox-width: 1000;
            viewbox-height: 1000;
            fit: fill;
            commands: root.up-area;
            fill: Theme.up.with-alpha(0.14);
        }
        Path {
            width: 100%;
            height: 100%;
            viewbox-width: 1000;
            viewbox-height: 1000;
            fit: fill;
            commands: root.up-line;
            stroke: Theme.up;
            stroke-width: 1.5px;
        }
        hover := TouchArea {}
        if hover.has-hover && root.points > 1: Rectangle {
            x: hover.mouse-x;
            width: 1px;
            background: Theme.text3;
        }
    }
    Text { x: root.left-pad; y: root.height - 16px; text: root.x-left; font-size: 11px; color: Theme.text3; }
    Text { x: root.width - self.width; y: root.height - 16px; text: root.x-right; font-size: 11px; color: Theme.text3; }
    if hover.has-hover && root.points > 1: Rectangle {
        property <int> idx: clamp(floor(hover.mouse-x / area.width * root.points), 0, root.points - 1);
        x: clamp(area.x + hover.mouse-x + 12px, 0, root.width - self.width);
        y: 8px;
        width: tt.preferred-width + 20px;
        height: tt.preferred-height + 12px;
        background: Theme.tooltip;
        border-radius: 6px;
        border-width: 1px;
        border-color: Theme.border;
        drop-shadow-blur: 8px;
        drop-shadow-color: #0003;
        tt := Text {
            text: root.tip(parent.idx);
            font-size: 12px;
            color: Theme.text;
        }
    }
}

// Столбчатая диаграмма: пары столбцов ↓/↑ на каждый интервал.
export component BarChart inherits Rectangle {
    in property <[Bar]> bars;
    in property <[string]> y-labels;
    property <length> left-pad: 76px;
    property <length> plot-w: root.width - root.left-pad;
    property <length> plot-h: root.height - 24px;
    property <length> slot: plot-w / max(1, root.bars.length);
    property <int> hover-idx: -1;
    min-height: 240px;
    for l[i] in root.y-labels: Rectangle {
        x: root.left-pad;
        y: root.plot-h * i / max(1, root.y-labels.length - 1);
        width: root.plot-w;
        height: 1px;
        background: Theme.grid;
        Text {
            x: -root.left-pad;
            y: -7px;
            width: root.left-pad - 8px;
            text: l;
            font-size: 11px;
            color: Theme.text3;
            horizontal-alignment: right;
        }
    }
    for b[i] in root.bars: Rectangle {
        x: root.left-pad + root.slot * i;
        y: 0;
        width: root.slot;
        height: root.height;
        property <length> bw: min(18px, max(2px, (root.slot - 4px) / 2.4));
        Rectangle {
            background: bta.has-hover ? Theme.grid.with-alpha(0.5) : transparent;
            height: root.plot-h;
            y: 0;
        }
        Rectangle {
            x: parent.width / 2 - parent.bw - 1px;
            width: parent.bw;
            height: root.plot-h * clamp(b.down, 0, 1);
            y: root.plot-h - self.height;
            background: Theme.down;
            border-top-left-radius: 2px;
            border-top-right-radius: 2px;
        }
        Rectangle {
            x: parent.width / 2 + 1px;
            width: parent.bw;
            height: root.plot-h * clamp(b.up, 0, 1);
            y: root.plot-h - self.height;
            background: Theme.up;
            border-top-left-radius: 2px;
            border-top-right-radius: 2px;
        }
        Text {
            y: root.plot-h + 6px;
            width: parent.width;
            text: b.label;
            font-size: 11px;
            color: Theme.text3;
            horizontal-alignment: center;
        }
        bta := TouchArea {
            changed has-hover => {
                if self.has-hover { root.hover-idx = i; } else if root.hover-idx == i { root.hover-idx = -1; }
            }
        }
    }
    if root.hover-idx >= 0 && root.hover-idx < root.bars.length: Rectangle {
        property <length> cx: root.left-pad + root.slot * (root.hover-idx + 0.5);
        x: cx + self.width + 16px > root.width ? cx - self.width - 8px : cx + 8px;
        y: 4px;
        width: btt.preferred-width + 20px;
        height: btt.preferred-height + 12px;
        background: Theme.tooltip;
        border-radius: 6px;
        border-width: 1px;
        border-color: Theme.border;
        drop-shadow-blur: 8px;
        drop-shadow-color: #0003;
        btt := Text {
            text: root.bars[root.hover-idx].tip;
            font-size: 12px;
            color: Theme.text;
        }
    }
}

// Кольцевая диаграмма с легендой.
export component Donut inherits HorizontalLayout {
    in property <[Slice]> slices;
    in property <string> center-text;
    spacing: 20px;
    Rectangle {
        width: 180px;
        height: 180px;
        for s in root.slices: Path {
            width: 100%;
            height: 100%;
            viewbox-width: 200;
            viewbox-height: 200;
            commands: s.path;
            fill: s.color;
        }
        Text {
            text: root.center-text;
            color: Theme.text;
            font-size: 14px;
            font-weight: 600;
            horizontal-alignment: center;
            vertical-alignment: center;
            width: 100px;
            wrap: word-wrap;
        }
    }
    VerticalLayout {
        alignment: center;
        spacing: 6px;
        horizontal-stretch: 1;
        for s in root.slices: HorizontalLayout {
            spacing: 8px;
            VerticalLayout { alignment: center; Rectangle { width: 10px; height: 10px; border-radius: 2px; background: s.color; } }
            Text { text: s.name; color: Theme.text; font-size: 12px; overflow: elide; horizontal-stretch: 1; }
            Text { text: s.value; color: Theme.text2; font-size: 12px; horizontal-alignment: right; width: 80px; }
            Text { text: s.pct; color: Theme.text2; font-size: 12px; horizontal-alignment: right; width: 44px; }
        }
    }
}

// Полоса заполнения (лимиты).
export component Meter inherits Rectangle {
    in property <float> value;
    height: 6px;
    border-radius: 3px;
    background: Theme.track;
    Rectangle {
        x: 0;
        width: parent.width * clamp(root.value, 0, 1);
        border-radius: 3px;
        background: root.value >= 1 ? Theme.danger : root.value >= 0.8 ? Theme.up : Theme.accent;
    }
}

// Легенда графика.
export component Legend inherits HorizontalLayout {
    spacing: 14px;
    alignment: start;
    horizontal-stretch: 0;
    HorizontalLayout {
        spacing: 6px;
        VerticalLayout { alignment: center; Rectangle { width: 10px; height: 10px; border-radius: 2px; background: Theme.down; } }
        Caption { text: @tr("Загрузка"); vertical-alignment: center; }
    }
    HorizontalLayout {
        spacing: 6px;
        VerticalLayout { alignment: center; Rectangle { width: 10px; height: 10px; border-radius: 2px; background: Theme.up; } }
        Caption { text: @tr("Отдача"); vertical-alignment: center; }
    }
}
